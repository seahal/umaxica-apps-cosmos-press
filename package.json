{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev",
    "lint": "oxlint . --ignore-pattern 'tmp/**'",
    "lint:fix": "oxlint --fix . --ignore-pattern 'tmp/**'",
    "format": "oxfmt src/styles *.ts *.json *.yaml *.yml",
    "format:check": "oxfmt --check src/styles *.ts *.json *.yaml *.yml",
    "typecheck": "tsc --noEmit",
    "build": "NODE_ENV=production vite build --mode production",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run openapi:lint && bun run openapi:verify",
    "ci": "bun run check && bun run build",
    "fix": "bun run format && bun run lint:fix",
    "openapi:lint": "redocly lint",
    "openapi:bundle": "redocly bundle",
    "openapi:verify": "bun run openapi:bundle && git diff --exit-code -- openapi/bundled/openapi.app.yml openapi/bundled/openapi.com.yml openapi/bundled/openapi.org.yml"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@redocly/cli": "^2.77.0",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-ruby": "^5.2.6"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26.13.1 <27"
  },
  "packageManager": "bun@1.4.0"
}
