# --- Jump gateway --------------------------------------------------------------
# PUBLIC_JUMP_GATEWAY_URL is the only Jump gateway setting: the browser-facing public HTTPS
# root origin, with no default. The gateway JWKS URI (<origin>/.well-known/jwks.json) and the
# Jump RT audience (the origin itself) are derived from it and cannot be configured separately.
# The removed settings JUMP_GATEWAY_URL, *_JWKS_URL and *_AUDIENCE are rejected at boot if
# present. PRIVATE_JUMP_GATEWAY_URL fails boot if set (even empty): Rails has no private path to Jump.
# Each Jump issuer identity (and its return origin and JWKS URI) comes from the existing
# PUBLIC_{AUTH,BASE,CORE,WARP}_{SERVICE,CORPORATE,STAFF}_URL and PUBLIC_PALM_SERVICE_URL values;
# there are no Jump-specific issuer or development key settings. Rails.env does not change the
# identity: when development uses a canonical origin, that origin's /.well-known/jwks.json must
# publish the local key from tmp/local_jwt_keysets.json, and that key then signs as the
# canonical issuer. localhost and private ingress names are never Jump identities. A Jump
# emulator is not implemented; a future one needs its own explicit security contract.
export PUBLIC_JUMP_GATEWAY_URL=https://jump.umaxica.net
# --- Diagnostic surfaces -----------------------------------------------------
# Three development-only dashboards, each on its own dedicated host behind HTTP
# Basic Auth. See adr/diagnostic-surfaces-performance-coverband-swagger.md.
#
# PUBLIC_* is the name a browser sees; PRIVATE_* is the network-side ingress the
# Cloudflare Tunnel connector reaches. Both are exact FQDNs -- no wildcard is
# admitted anywhere, so a spoofed Host cannot reach one dashboard through
# another's name.
export PUBLIC_PERFORMANCE_URL=performance.umaxica.dev
export PRIVATE_PERFORMANCE_URL=performance.core.dev.localhost
export PUBLIC_COVERBAND_URL=coverband.umaxica.dev
export PRIVATE_COVERBAND_URL=coverband.core.dev.localhost
export PUBLIC_SWAGGER_URL=swagger.umaxica.dev
export PRIVATE_SWAGGER_URL=swagger.core.dev.localhost

# Diagnostic dashboards stay on VALKEY_DIAGNOSTIC_HOST (compatibility `valkey`).
# Logical DBs 12/13 are declared in config/valkey.yml. Do not point Coverband
# or rails_performance at cache or KVS.

# Read through Rails.app.creds.option, which checks ENV first and then Rails
# credentials. With the password left unset, each surface answers 401 -- the guards
# fail closed. Set local dashboard passwords in .envrc.credential when needed.
export RAILS_PERFORMANCE_USERNAME=admin
export COVERBAND_USERNAME=admin
export SWAGGER_USERNAME=admin

# Optional per-surface switches. Both default to on. Only the exact string
# "false" disables, so a typo cannot silently turn observability off.
# Swagger has no toggle of its own: unset its PUBLIC_/PRIVATE_ pair above and
# the host drops out of both the route constraint and Host Authorization.
export RAILS_PERFORMANCE_ENABLED=true
export COVERBAND_ENABLED=true
# Explicit non-secret local Secret retention lifetimes used by the retention worker.
export APP_SECRET_PURGE_DELAY_SECONDS=86400
export APP_SECRET_OUTBOX_RETENTION_SECONDS=604800
export APP_SECRET_PROOF_RETENTION_SECONDS=2592000
export APP_SECRET_ISSUANCE_TTL_SECONDS=600
# Non-secret local dead-history keys. Production supplies independent secrets.
export APP_EMAIL_HISTORY_KEY=local-app-email-dead-history-key
export APP_TELEPHONE_HISTORY_KEY=local-app-telephone-dead-history-key
export ORG_EMAIL_HISTORY_KEY=local-org-email-dead-history-key
export ORG_TELEPHONE_HISTORY_KEY=local-org-telephone-dead-history-key
# Non-secret local ceremony verifier keys. Production supplies independent secrets.
export APP_EMAIL_OTP_VERIFIER_KEY=local-app-email-otp-verifier-key
export APP_TELEPHONE_OTP_VERIFIER_KEY=local-app-telephone-otp-verifier-key
export ORG_EMAIL_OTP_VERIFIER_KEY=local-org-email-otp-verifier-key
export ORG_TELEPHONE_OTP_VERIFIER_KEY=local-org-telephone-otp-verifier-key
# Non-secret local identifier encryption keyrings. Production supplies independent secrets.
export APP_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=local-app-identifier-encryption-primary
export APP_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=local-app-identifier-encryption-derivation
export ORG_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=local-org-identifier-encryption-primary
export ORG_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=local-org-identifier-encryption-derivation
# Non-secret local realm identifier keys. Production must provide independent secrets.
export APP_EMAIL_ADDRESS_HMAC_KEY=local-app-email-identifier-key
export ORG_EMAIL_ADDRESS_HMAC_KEY=local-org-email-identifier-key
export APP_TELEPHONE_NUMBER_HMAC_KEY=local-app-telephone-identifier-key
export ORG_TELEPHONE_NUMBER_HMAC_KEY=local-org-telephone-identifier-key

# Development-only values moved from .envrc.credential. None of these is a real credential.
export FAKECLOUD_HOST_PORT=24566
export POSTGRESQL_PRIMARY_HOST_PORT=25432
export POSTGRESQL_REPLICA_HOST_PORT=25433
export VALKEY_HOST_PORT=26379
export VALKEY_CACHE_HOST_PORT=26380
export VALKEY_KVS_HOST_PORT=26381
export PARALLEL_WORKERS=12

# Development-only values. None of these is a real credential.
export FLIPPER_UI_PASSWORD=pass
export BLAZER_PASSWORD=pass
export PGHERO_PASSWORD=pass

# Override order, broadest first; a later file wins:
#   .envrc (shared, committed) -> .envrc.credential (real credentials only,
#   git-ignored) -> .envrc.local (this machine only, git-ignored)
source_env_if_exists .envrc.credential
source_env_if_exists .envrc.local
