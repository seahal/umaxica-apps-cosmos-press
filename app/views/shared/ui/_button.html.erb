<%
  variant ||= :primary
  type ||= :button
%>

<% if local_assigns[:href] %>
  <% link_options = {} %>
  <% link_options[:data] = local_assigns[:data] if local_assigns[:data] %>
  <%= link_to href, link_options do %>
    <%= local_assigns[:label] || yield %>
  <% end %>
<% else %>
  <%= tag.button(
        type: type,
        class: local_assigns[:class].presence,
        disabled: local_assigns[:disabled] ? true : nil,
        data: local_assigns[:data],
      ) do %>
    <%= local_assigns[:label] || yield %>
  <% end %>
<% end %>
